# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_email?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-key
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Encryption (32-byte key, hex-encoded: openssl rand -hex 32)
ENCRYPTION_KEY=

# Frontend
FRONTEND_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
GOOGLE_MAIL_CALLBACK_URL=http://localhost:3000/email-accounts/connect/google/callback
GOOGLE_CALENDAR_CALLBACK_URL=http://localhost:3000/calendar-accounts/connect/google/callback

# Microsoft OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:3000/auth/microsoft/callback
MICROSOFT_MAIL_CALLBACK_URL=http://localhost:3000/email-accounts/connect/microsoft/callback
MICROSOFT_CALENDAR_CALLBACK_URL=http://localhost:3000/calendar-accounts/connect/microsoft/callback

# Slack (v3.0 Integrations — optional; leave unset until you've created a
# Slack app at api.slack.com/apps with the chat:write and channels:read
# bot scopes, redirect URL set to SLACK_CALLBACK_URL below)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_CALLBACK_URL=http://localhost:3000/integrations/connect/slack/callback

# Microsoft Teams (v3.0 Integrations — optional; reuses the MICROSOFT_CLIENT_ID/
# SECRET app registration above, just add this redirect URI to it and grant
# Team.ReadBasic.All, Channel.ReadBasic.All, ChannelMessage.Send delegated
# permissions)
MICROSOFT_TEAMS_CALLBACK_URL=http://localhost:3000/integrations/connect/teams/callback

# HubSpot (v3.0 Integrations — optional; leave unset until you've created an
# app at developers.hubspot.com with the crm.objects.contacts.write scope,
# redirect URL set to HUBSPOT_CALLBACK_URL below)
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_CALLBACK_URL=http://localhost:3000/integrations/connect/hubspot/callback

# AI Service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=

# Logging
LOG_LEVEL=debug