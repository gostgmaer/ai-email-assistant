generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EmailProvider {
  GOOGLE
  MICROSOFT
  IMAP
}

enum MailFolderType {
  INBOX
  SENT
  DRAFTS
  TRASH
  SPAM
  ARCHIVE
  CUSTOM
}

enum SyncStatus {
  IDLE
  SYNCING
  ERROR
}

model User {
  id          String  @id @default(uuid())
  email       String  @unique
  displayName String?
  avatar      String?

  googleId    String? @unique
  microsoftId String? @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  emailAccounts EmailAccount[]
  refreshTokens RefreshToken[]
  notifications Notification[]

  @@index([createdAt])
}

model Notification {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String
  body     String
  metadata Json?

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model RefreshToken {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailAccount {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider EmailProvider

  email       String
  displayName String?

  isPrimary   Boolean @default(false)
  syncEnabled Boolean @default(true)

  // IMAP-only connection settings (host/port/secure/username); null for GOOGLE/MICROSOFT
  imapConfig Json?

  syncStatus   SyncStatus @default(IDLE)
  lastSyncedAt DateTime?
  lastSyncError String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  credential EmailCredential?

  folders MailFolder[]
  threads EmailThread[]

  @@unique([provider, email])
  @@index([userId])
}

model EmailCredential {
  id String @id @default(uuid())

  accountId String       @unique
  account   EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MailFolder {
  id String @id @default(uuid())

  accountId String
  account   EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  providerFolderId String?

  name String

  type MailFolderType

  /** Opaque provider cursor (Gmail historyId, Graph delta token, IMAP UID) for incremental sync. */
  syncCursor String?

  threads EmailThread[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, providerFolderId])
  @@index([accountId])
}

model EmailThread {
  id String @id @default(uuid())

  // The account this conversation belongs to. Provider thread IDs are
  // stable across folders/labels (e.g. Gmail keeps the same thread ID
  // for a message whether it's under INBOX or SENT), so thread identity
  // is scoped per-account, not per-folder.
  accountId String
  account   EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // The folder this thread is primarily displayed under. Set once when
  // the thread is first created and left unchanged afterwards, so a
  // reply doesn't move an Inbox conversation into "Sent".
  folderId String
  folder   MailFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  providerThreadId String

  subject String?

  snippet String?

  lastMessageAt DateTime?

  messages EmailMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, providerThreadId])
  @@index([folderId])
}

model EmailMessage {
  id String @id @default(uuid())

  threadId String
  thread   EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  providerMessageId String

  from Json

  to Json

  cc Json?

  bcc Json?

  subject String?

  bodyText String?

  bodyHtml String?

  receivedAt DateTime

  isRead Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([threadId, providerMessageId])
  @@index([threadId])
}
