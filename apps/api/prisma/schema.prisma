generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

enum EmailProvider {
  GOOGLE
  MICROSOFT
  IMAP
}

enum MailFolderType {
  INBOX
  SENT
  DRAFTS
  TRASH
  SPAM
  ARCHIVE
  CUSTOM
}

enum SyncStatus {
  IDLE
  SYNCING
  ERROR
  // The provider rejected our credentials (revoked/expired refresh token,
  // changed IMAP password). Retrying can't fix it — background sync stops
  // for this account until the user reconnects it.
  AUTH_REQUIRED
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum DocumentStatus {
  PROCESSING
  INDEXED
  FAILED
}

// OWNER is always the account's connecting user (EmailAccount.userId) and
// gets an AccountMember row created alongside it — "who can access this
// account" is then always exactly "SELECT * FROM AccountMember WHERE
// accountId = X", with no special-casing of the owner at query sites.
// MEMBER is everyone explicitly invited afterward. Two roles only for
// v2.0; see docs/v2.0-plan.md's "Open decisions" for why a third
// (read-only VIEWER) tier is deferred rather than added speculatively.
enum AccountRole {
  OWNER
  MEMBER
}

model User {
  id          String  @id @default(uuid())
  email       String  @unique
  displayName String?
  avatar      String?

  // Sender identity for AI-generated replies (passed to the reply prompt
  // as sender_profile, see AiProcessingProcessor). Optional.
  jobTitle    String?
  companyName String?

  // IANA zone (e.g. "Europe/Berlin"). Quiet hours and business hours on the
  // user's accounts are read in this zone. Defaults to UTC.
  timezone String @default("UTC")

  // Local hour (0-23, in `timezone`) the daily digest goes out.
  digestHour Int @default(8)

  // Null for OAuth-only users (Google/Microsoft) who never set a password.
  passwordHash    String?
  emailVerifiedAt DateTime?

  googleId    String? @unique
  microsoftId String? @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  emailAccounts           EmailAccount[]
  calendarAccounts        CalendarAccount[]
  refreshTokens           RefreshToken[]
  notifications           Notification[]
  verificationTokens      VerificationToken[]
  contactMemories         ContactMemory[]
  documents               Document[]
  tasks                   Task[]
  accountMemberships      AccountMember[]
  assignedThreads         EmailThread[]            @relation("ThreadAssignee")
  threadNotes             ThreadNote[]
  approvalSteps           ApprovalStep[]
  notificationPreferences NotificationPreference[]

  @@index([createdAt])
}

model VerificationToken {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type VerificationTokenType

  tokenHash String @unique

  /**
   * Only set for EMAIL_CHANGE: the address being switched to.
   */
  newEmail String?

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId, type])
}

model Notification {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String
  body     String
  metadata Json?

  // What kind of event this is — decides which channels it goes out on
  // (NotificationPreference). Null for rows written before channels existed.
  event NotificationEvent?

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

enum NotificationEvent {
  URGENT_MAIL
  APPROVAL_REQUESTED
  DRAFT_READY
  SYNC_FAILED
  DIGEST
  FOLLOW_UP
  SNOOZE_WAKE
  // A commitment from the user's sent mail is due.
  COMMITMENT_DUE
  // Auto-sends, scheduled sends, send limits — the automation itself.
  AUTOMATION
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SLACK
}

/**
 * Per-user channel choice per event (docs/email-automation-implementation-
 * plan.md §6.2). A missing row means the default: in-app on, email and
 * Slack off. SLACK rows name the Slack integration and channel to post to
 * (integrations are account-scoped; the user picks one they can access).
 */
model NotificationPreference {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  event   NotificationEvent
  channel NotificationChannel
  enabled Boolean             @default(true)

  slackIntegrationId String?
  slackChannelId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, event, channel])
}

model RefreshToken {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  // Captured at issuance for the "active sessions" list.
  userAgent   String?
  ipAddress   String?
  deviceLabel String?

  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailAccount {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider EmailProvider

  email       String
  displayName String?

  isPrimary   Boolean @default(false)
  syncEnabled Boolean @default(true)

  // Opt-in: when true, a MEETING_REQUEST task extracted from this account's
  // mail is scheduled automatically (AI-suggested time, event created, and
  // a confirmation reply sent) with no human review — see
  // MeetingSchedulingService.autoSchedule(). Off by default, same
  // human-approval-first posture as WorkflowRule's AUTO_REPLY action.
  // Deliberately NOT expressed as a WorkflowRule: it's driven by task
  // extraction (MEETING_REQUEST), a different trigger than WorkflowRule's
  // NEW_MESSAGE/classify-based evaluation — see docs/v2.0-plan.md §3.
  autoScheduleMeetings Boolean @default(false)

  // Per-account kill switch for autonomous sending (alongside the global
  // AUTO_SEND_ENABLED env var — both must allow it). When false, a reply a
  // matching AUTO_REPLY rule would have sent is held as a draft instead;
  // everything else in the AI pipeline (classify, rules, drafts) still
  // runs. See docs/email-automation-implementation-plan.md §0.2.
  autoSendEnabled Boolean @default(true)

  // Inbound mail received before this moment never enters the AI
  // pipeline — the first sync of a newly connected mailbox imports
  // history, and replying to (or auto-sending into) weeks-old threads is
  // never what connecting an account means. Defaults to the connect time.
  aiEnabledFrom DateTime @default(now())

  // Per-category sync filters (see bulk-mail.util.ts). Default true means
  // "exclude by default" — the aggressive-filtering behavior most users
  // want out of the box. Flip to false to let that category sync anyway.
  // Header-based and automated-sender detection are NOT here — they're
  // always on, not user-configurable.
  filterMarketing     Boolean @default(true)
  filterOtp           Boolean @default(true)
  filterPasswordReset Boolean @default(true)
  filterBilling       Boolean @default(true)
  filterShipping      Boolean @default(true)
  filterCalendar      Boolean @default(true)

  // Smart triage: keep newsletter mail (mailing-list headers or marketing)
  // in a Newsletters group instead of dropping it at sync. Kept
  // newsletters never enter the AI pipeline or the Ask index. Off by
  // default, so nothing changes until the user opts in.
  keepNewsletters Boolean @default(false)

  // Output validation §6 (see docs/enterprise-ai-pipeline-plan.md) —
  // case-insensitive substring check against every AI-generated reply
  // before it's allowed to auto-send (e.g. "refund", "discount",
  // "guarantee"). Deliberately just a mechanism, not pre-populated with
  // any actual policy content — this codebase doesn't know this
  // account's real business rules, and inventing placeholder ones would
  // mean silently blocking or (worse) not blocking real replies based on
  // made-up policy. Empty by default, same opt-in posture as everything
  // else auto-send-adjacent here.
  prohibitedPhrases String[] @default([])

  // Auto-send limits (docs/email-automation-implementation-plan.md §5.4).
  // Caps count this account's autonomous sends over a rolling hour/day;
  // over a cap, the reply is held as a draft. The confidence threshold is
  // the minimum validate_reply score for an auto-send.
  autoSendHourlyCap           Int @default(10)
  autoSendDailyCap            Int @default(50)
  autoSendConfidenceThreshold Int @default(70)

  // "HH:MM" in the owner's User.timezone. An auto-send that falls inside
  // quiet hours is scheduled for the window's end. Both null = no quiet
  // hours. The window may wrap midnight (22:00-07:00).
  quietHoursStart String?
  quietHoursEnd   String?

  // Undo window: autonomous replies wait this long (0-300s) as a scheduled
  // draft before they actually send, so they can be cancelled.
  undoSendSeconds Int @default(0)

  // What the withinBusinessHours rule condition checks, in the owner's
  // User.timezone. Days use 0 = Sunday ... 6 = Saturday.
  businessHoursStart String @default("09:00")
  businessHoursEnd   String @default("17:00")
  businessDays       Int[]  @default([1, 2, 3, 4, 5])

  // Appended to every AI-generated reply after generation — the model never
  // writes it. Null = never set (Gmail's sendAs signature is imported on
  // sync); an empty string = explicitly no signature.
  signatureText String?
  signatureHtml String?

  // IMAP-only connection settings (host/port/secure/username); null for GOOGLE/MICROSOFT
  imapConfig Json?

  syncStatus    SyncStatus @default(IDLE)
  lastSyncedAt  DateTime?
  lastSyncError String?

  // Sync health (see EmailSyncService.recordSyncFailure): consecutive
  // failed syncs, and the earliest time the background scan may try this
  // account again (exponential backoff). Both reset on a successful sync
  // or a reconnect.
  consecutiveSyncFailures Int       @default(0)
  nextSyncAt              DateTime?

  // The account's other send-as addresses (Gmail sendAs, Microsoft
  // proxyAddresses), lowercased. Mail from any of these is the user's own
  // — never "inbound", never something to auto-reply to. Refreshed at most
  // daily (aliasesRefreshedAt) since it costs an extra API call.
  aliases            String[]  @default([])
  aliasesRefreshedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  credential EmailCredential?

  folders        MailFolder[]
  threads        EmailThread[]
  members        AccountMember[]
  workflowRules  WorkflowRule[]
  agents         Agent[]
  contacts       Contact[]
  integrations   Integration[]
  approvalChains ApprovalChain[]
  ruleExecutions RuleExecution[]

  writingStyleProfile WritingStyleProfile?

  @@unique([provider, email])
  @@index([userId])
}

/**
 * Shared Inbox access grant — deliberately scoped to one EmailAccount, not
 * an org/workspace. See docs/v2.0-plan.md: v2.0 does account-level
 * sharing, full multi-tenancy (organizations, cross-account RBAC, SSO) is
 * v3.0. A row here (including the OWNER row, created alongside the
 * account itself) is the single source of truth for "can this user act on
 * this account" — see AccountRole's comment.
 */
model AccountMember {
  id String @id @default(uuid())

  accountId String
  account   EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role AccountRole @default(MEMBER)

  // Who sent the invite that created this row; null for the OWNER row
  // (created by the connect flow itself, not an invite).
  invitedByUserId String?

  createdAt DateTime @default(now())

  @@unique([accountId, userId])
  @@index([userId])
}

/**
 * Workflow Builder (v2.0 §3) — a user-configurable generalization of what
 * WAS three hardcoded checks (auto-send-by-category, and this same shape
 * again for auto-schedule-meetings). Evaluated against NEW_MESSAGE
 * classification only for now (see docs/v2.0-plan.md §3) — first
 * enabled rule (ordered by `order`) whose `conditions` all match wins;
 * its `actions` execute in order. No match falls through to today's
 * default: draft the reply for human review.
 * `conditions`/`actions` are typed at the application layer
 * (WorkflowCondition[] / WorkflowAction[] in workflow-rule.types.ts) —
 * kept as Json rather than normalized tables for the same reason
 * `imapConfig`/`generationMetadata` are: the shape is genuinely
 * heterogeneous (an ASSIGN_TO action carries a userId, a NOTIFY action
 * carries a message) and this is a v1 rules engine, not a stable wire
 * format other systems depend on yet.
 */
model WorkflowRule {
  id String @id @default(uuid())

  accountId String
  account   EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  name    String
  enabled Boolean @default(true)

  // Lower runs first. Ties broken by createdAt.
  order Int @default(0)

  /// WorkflowConditionGroup — a tree of all/any/not groups over
  /// conditions (see workflow-rule.types.ts). A rule with no conditions must
  /// say so explicitly with `matchAll: true`. Rows saved before 2026-10
  /// held a flat AND list; the phase 5 migration converted them.
  conditions Json

  /// WorkflowAction[] — executed in order when this rule matches.
  actions Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  executions RuleExecution[]

  @@index([accountId, order])
}

/**
 * Rule history (docs/email-automation-implementation-plan.md §5.3): one row
 * per rule that matched a message, with what each of its actions did.
 * Rules that didn't match aren't recorded — "Test rule" (dry-run) answers
 * that question. Kept for 90 days (AutomationProcessor's cleanup job).
 */
model RuleExecution {
  id String @id @default(uuid())

  accountId String
  account   EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // SetNull: history outlives a deleted rule; ruleName is the snapshot.
  ruleId   String?
  rule     WorkflowRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  ruleName String

  messageId String
  message   EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  /// WorkflowAction[] as they were when the rule ran.
  actions Json

  /// RuleActionResult[] — one per action: { type, status: done | skipped |
  /// failed, detail? }.
  results Json

  durationMs Int

  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([ruleId, createdAt])
  @@index([messageId])
}

enum ApprovalChainStatus {
  PENDING
  APPROVED
  REJECTED
  // Nobody finished deciding before expiresAt — the draft is kept and can
  // be sent manually, same as REJECTED.
  EXPIRED
  // The gated draft was deleted (or sent manually) while still PENDING.
  CANCELLED
}

// WAITING (not yet this step's turn) is distinct from PENDING (this
// step's turn right now, actionable) specifically so "which chains need
// action from user X" is a trivial `WHERE approverUserId = X AND status
// = PENDING` query — see ApprovalChainService.listPendingForUser — rather
// than every caller re-deriving "am I the earliest still-open step" from
// order + sibling status.
enum ApprovalStepStatus {
  WAITING
  PENDING
  APPROVED
  REJECTED
}

/**
 * v3.0 True multi-step Approval Chains (docs/MVP.md) — extends the
 * Workflow Builder's existing single auto-send-vs-draft gate (a
 * REQUIRE_APPROVAL_CHAIN WorkflowAction) with sequential multi-person
 * sign-off before a drafted AI reply is allowed to send. One row per
 * matched action, created right after the gated reply is saved as a
 * draft — see AiProcessingProcessor. 1:1 with the draft EmailMessage via
 * a unique FK: each drafted reply that matches a chain rule gets its own
 * approval run, never reused across drafts.
 * Steps run in `order`, one pending approver at a time (see
 * ApprovalChainService.approve/reject) — approving a non-final step just
 * advances to the next approver; approving the final step sends the
 * draft immediately (same human-approval-first posture as AUTO_REPLY,
 * just gated behind N humans instead of zero). Rejecting any step is
 * terminal: the chain stops, the draft is left alone in Drafts for
 * manual rework, same as today's default hold-for-review outcome.
 */
model ApprovalChain {
  id String @id @default(uuid())

  accountId String
  account   EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // SetNull, not Cascade: sending the draft deletes it, and the chain is
  // the audit record of who approved what — it must outlive the draft.
  // The draft* snapshot fields below keep that record meaningful after.
  draftMessageId String?       @unique
  draftMessage   EmailMessage? @relation(fields: [draftMessageId], references: [id], onDelete: SetNull)

  status ApprovalChainStatus @default(PENDING)

  // Snapshot of the gated draft taken when the chain is created.
  draftSubject    String?
  draftRecipients Json?

  // Provider-side id of the message the approved draft was sent as.
  sentMessageId String?

  // Pending chains expire (EXPIRED) at expiresAt; the current approver is
  // reminded once, halfway there (reminderSentAt). See
  // ApprovalChainService.sweep.
  expiresAt      DateTime?
  reminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps ApprovalStep[]

  @@index([accountId])
  @@index([status, expiresAt])
}

model ApprovalStep {
  id String @id @default(uuid())

  chainId String
  chain   ApprovalChain @relation(fields: [chainId], references: [id], onDelete: Cascade)

  // Lower runs first. Exactly one step per chain is ever PENDING at a
  // time — order 0 starts PENDING, every later step starts WAITING and
  // is promoted to PENDING only once its predecessor is APPROVED.
  order Int

  approverUserId String
  approver       User   @relation(fields: [approverUserId], references: [id], onDelete: Cascade)

  status    ApprovalStepStatus @default(WAITING)
  comment   String?
  decidedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([chainId, order])
  @@index([approverUserId, status])
}

/**
 * AI Agents (v2.0 §4) — a named persona (system prompt), not new
 * generation infrastructure. Layers on the existing reply capability:
 * WorkflowRule's AUTO_REPLY action can carry an agentId, and when it does,
 * apps/ai's reply.md default prompt is replaced entirely by this agent's
 * systemPrompt (see ReplyRequest.system_prompt_override). Genuinely
 * autonomous multi-step agents beyond what a WorkflowRule chain already
 * does are deliberately out of scope — see docs/v2.0-plan.md §4.
 */
model Agent {
  id String @id @default(uuid())

  accountId String
  account   EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  name         String
  systemPrompt String
  enabled      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
}

/**
 * CRM v1 — a structured contact record per account, distinct from
 * ContactMemoryService's AI-inferred embedding "facts" (which stays as
 * unstructured, per-sender context for reply generation, not a CRM).
 * Deliberately NOT auto-populated by the AI pipeline — a Contact only
 * ever gets created by an explicit user action, so the CRM doesn't
 * silently fill up with every marketing sender or notification address
 * that happens to email the account. The pipeline only updates
 * lastContactedAt on an EXISTING match (see AiProcessingProcessor).
 * Pipeline/deal stages, lead qualification, and pricing lookup are
 * out of scope for this pass — see docs/enterprise-ai-pipeline-plan.md §4.
 */
model Contact {
  id String @id @default(uuid())

  accountId String
  account   EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  email   String
  name    String?
  company String?
  phone   String?
  notes   String?
  tags    String[] @default([])

  // Loosely-typed, matching category/priority's convention elsewhere in
  // this schema — free text like "Lead"/"Customer"/"Other", not a fixed
  // enum.
  status String?

  lastContactedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, email])
  @@index([accountId])
}

model EmailCredential {
  id String @id @default(uuid())

  accountId String       @unique
  account   EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum IntegrationProvider {
  SLACK
  TEAMS
  HUBSPOT
}

/**
 * v3.0 Integrations (docs/MVP.md) — external services a WorkflowRule's
 * actions can post to (e.g. POST_TO_SLACK, POST_TO_TEAMS,
 * CREATE_HUBSPOT_CONTACT). Scoped to an EmailAccount, not a User: same
 * shape as Agent/WorkflowRule, since a connection is meant to be used by
 * that account's rules, and different accounts may want different
 * workspaces/tenants/portals. Slack was the first provider, built
 * end-to-end as the template for the rest (see docs/v2.0-plan.md §5,
 * which explicitly recommends this over building a generic "integrations
 * framework" speculatively) — Teams and HubSpot follow the exact same
 * shape. Token storage mirrors EmailCredential (AES-256-GCM via
 * EncryptionService). refreshToken/expiresAt are null for Slack (its bot
 * tokens don't expire/rotate) but required in practice for Teams
 * (Microsoft Graph, ~1hr access tokens) and HubSpot (~30min) — see
 * IntegrationService.getValidAccessToken's refresh handling.
 */
model Integration {
  id String @id @default(uuid())

  accountId String
  account   EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  provider IntegrationProvider

  // Display-only workspace/tenant/portal identity — not used for auth.
  // Slack: team id/name. Teams: AAD tenant id/organization display name.
  // HubSpot: hub (portal) id/account name.
  workspaceId   String?
  workspaceName String?

  accessToken  String
  refreshToken String?
  expiresAt    DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([accountId, provider])
  @@index([accountId])
}

enum CalendarProvider {
  GOOGLE
  MICROSOFT
}

// Deliberately separate from EmailAccount, not a calendar-scoped extension
// of it — a user may want calendar access without granting mail access (or
// vice versa), and Google/Microsoft both treat these as independently
// grantable OAuth scopes. See docs/v1.2-plan.md's Calendar Integration
// section for the design rationale.
model CalendarAccount {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider CalendarProvider

  email       String
  displayName String?

  isPrimary Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  credential CalendarCredential?

  @@unique([provider, email])
  @@index([userId])
}

model CalendarCredential {
  id String @id @default(uuid())

  accountId String          @unique
  account   CalendarAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MailFolder {
  id String @id @default(uuid())

  accountId String
  account   EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  providerFolderId String?

  name String

  type MailFolderType

  /**
   * Opaque provider cursor (Gmail historyId, Graph delta token, IMAP UID) for incremental sync.
   */
  syncCursor String?

  threads EmailThread[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, providerFolderId])
  @@index([accountId])
}

model EmailThread {
  id String @id @default(uuid())

  // The account this conversation belongs to. Provider thread IDs are
  // stable across folders/labels (e.g. Gmail keeps the same thread ID
  // for a message whether it's under INBOX or SENT), so thread identity
  // is scoped per-account, not per-folder.
  accountId String
  account   EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // The folder this thread is primarily displayed under. Set once when
  // the thread is first created and left unchanged afterwards, so a
  // reply doesn't move an Inbox conversation into "Sent".
  folderId String
  folder   MailFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  providerThreadId String

  subject String?

  snippet String?

  lastMessageAt DateTime?

  // Whether the newest message (the one lastMessageAt describes) was sent
  // by the account itself — kept in step with lastMessageAt by sync and
  // compose, so "threads awaiting the other side's reply" (follow-ups) is a
  // plain indexed query instead of fetching threads and filtering in code.
  lastMessageFromSelf Boolean @default(false)

  // Set to hide this thread from the default inbox view until this time —
  // purely a query-time filter (see InboxService.listThreads), not a job:
  // there's nothing to actively "resurface", the thread just stops being
  // excluded once this timestamp passes. Null means not snoozed.
  snoozedUntil DateTime?

  // "Remind me if nobody replies by then" — set from compose. The hourly
  // follow-up scan turns it into a FOLLOW_UP task + notification if the
  // last message is still the user's own, then clears it.
  followUpAt DateTime?

  // "Not waiting on this" from the Waiting view — hides the thread there
  // (and clears followUpAt) until the user sends another message, i.e.
  // until lastMessageAt moves past it. Null means never dismissed.
  waitingDismissedAt DateTime?

  // Shared Inbox (v2.0): who on the account is responsible for this
  // conversation. Must be an AccountMember of this thread's account —
  // enforced in InboxService, not at the schema level (Prisma can't
  // express "assignedTo must be a member of this.accountId"). Null means
  // unassigned; assigning/unassigning doesn't change any AI pipeline
  // behavior, it's purely a collaboration signal.
  assignedToUserId String?
  assignedTo       User?   @relation("ThreadAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  // Re-summarized (overwritten, not appended) each time the automated AI
  // pipeline processes a new message on a thread with 2+ messages — a
  // single fresh message has nothing to summarize. Null until then.
  summary          String?
  summaryKeyPoints String[] @default([])

  // Smart triage (docs/ai-features-implementation-plan.md, Phase 2): which
  // inbox group the thread belongs in, decided from its newest message by
  // ThreadTriageService — no AI call of its own, it reuses needsReply and
  // the sync-time bulk-mail signals. Null until first computed (older
  // threads are filled in by the triage scan).
  triage ThreadTriage?

  messages EmailMessage[]
  tasks    Task[]
  notes    ThreadNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, providerThreadId])
  @@index([folderId])
  @@index([snoozedUntil])
  @@index([followUpAt])
  @@index([assignedToUserId])
  @@index([lastMessageFromSelf, lastMessageAt])
  @@index([accountId, triage])
}

/// Inbox groups for smart triage — see EmailThread.triage.
enum ThreadTriage {
  NEEDS_REPLY
  FYI
  NOTIFICATION
  NEWSLETTER
}

/**
 * Shared Inbox (v2.0) internal note on a thread — visible only to the
 * account's members, never sent to the external party or included in any
 * AI prompt context. Deliberately its own model rather than reusing
 * EmailMessage: a note isn't a message (no from/to/provider IDs, doesn't
 * sync anywhere, can be deleted freely without touching provider state).
 */
model ThreadNote {
  id String @id @default(uuid())

  threadId String
  thread   EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  body String

  createdAt DateTime @default(now())

  @@index([threadId])
}

model EmailMessage {
  id String @id @default(uuid())

  threadId String
  thread   EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  providerMessageId String

  from Json

  to Json

  cc Json?

  bcc Json?

  subject String?

  bodyText String?

  bodyHtml String?

  receivedAt DateTime

  isRead Boolean @default(false)

  // Set when this message is an AI-drafted reply awaiting review (a local
  // draft, not yet sent) — points at the message it's replying to.
  inReplyToMessageId String?
  inReplyTo          EmailMessage?  @relation("MessageReplies", fields: [inReplyToMessageId], references: [id], onDelete: SetNull)
  draftReplies       EmailMessage[] @relation("MessageReplies")

  // Set once the autonomous AI pipeline (classify -> contact memory ->
  // reply) has run for this message, so retries/resyncs don't reprocess it.
  aiProcessedAt DateTime?

  // True when the message looks machine-generated as a reply (Auto-
  // Submitted, X-Autoreply, out-of-office subject, bounce sender — see
  // detectBulkMailSignals' autoReply). Such a message can still be synced
  // (it's part of a real conversation) but must never trigger an
  // autonomous send back, or two auto-responders can loop forever.
  isAutoReply Boolean @default(false)

  // Set when sync judged this inbound message to be bulk mail (see
  // bulkKindOf in bulk-mail.util.ts): NEWSLETTER for mailing-list and
  // marketing mail, NOTIFICATION for other automated mail. Such mail is
  // normally dropped at sync; it's only stored when it's part of a real
  // conversation, or when the account keeps newsletters. Null for
  // everything else. Never one of the other ThreadTriage values.
  bulkKind ThreadTriage?

  // Raw List-Unsubscribe / List-Unsubscribe-Post headers (RFC 2369 / RFC
  // 8058), for the Unsubscribe button on newsletter threads.
  listUnsubscribe     String?
  listUnsubscribePost String?

  // Set only on a message sent from an AI-generated draft: whether the
  // human changed the AI's text before sending. Null for everything else.
  aiEdited Boolean?

  // Set when the AI pipeline gave up on this message after its last retry
  // (see AiProcessingProcessor's failed handler) — what the UI shows as
  // "AI processing failed — retry". Cleared when it's re-queued.
  aiFailedAt DateTime?
  aiError    String?

  // Reply addressing/threading headers (RFC 5322). replyTo is where a reply
  // should go when set (forms, help desks, lists); messageIdHeader and
  // references are what a reply's In-Reply-To/References must carry for
  // other clients to thread it — Gmail's own message id is NOT a
  // Message-ID. Null/empty for rows synced before these existed.
  replyTo         Json?
  messageIdHeader String?
  references      String[] @default([])

  automationEffects AutomationEffect[]
  ruleExecutions    RuleExecution[]
  attachments       EmailAttachment[]

  // Set on an AI draft whose auto-send is scheduled (undo window, quiet
  // hours, DELAY_SEND) — when it will send unless cancelled. Cleared when
  // the send is cancelled; the draft row is gone once it sends.
  scheduledSendAt DateTime?

  /// Set only on AI-generated replies (drafted or auto-sent) — records what
  /// grounded the generation so "did this use my documents?" is answerable
  /// without re-deriving it. Null for synced/manually-composed messages.
  /// Shape: { ragUsed, contactMemoryUsed, provider, model, usage,
  /// documents: [{ documentId, chunkId, filename, distance }] }.
  generationMetadata Json?

  // Persisted output of the classify AI capability (previously computed on
  // every processed message and discarded — see AiProcessingProcessor).
  // Loosely-typed strings, not enums: mirrors ClassificationResult on the
  // AI service side, which isn't constrained to a fixed value set either.
  category  String?
  priority  String?
  sentiment String?
  isSpam    Boolean @default(false)

  // ISO 639-1 code (e.g. "en"), best-effort from the classify LLM call —
  // not a dedicated language-detection model. Null for messages processed
  // before this field existed.
  language String?

  // Best-effort PII flag from the same classify call — informational only
  // today (nothing gates on it yet). piiTypes is always [] when false.
  containsPii Boolean  @default(false)
  piiTypes    String[] @default([])

  // Whether this message calls for a reply (classify's needs_reply, after
  // AiProcessingProcessor's deterministic pre-filter) and why. No reply is
  // generated when false. Null for messages processed before this existed.
  needsReply  Boolean?
  replyReason String?

  tasks Task[]

  // "Ask your inbox": when this message's text was split into EmailChunk
  // rows and embedded. Null means not indexed yet — the search-index job
  // picks those up newest first, so one code path covers the backfill,
  // newly synced mail and sent mail. Set even when nothing was indexable
  // (empty body), so such a message isn't retried forever.
  searchIndexedAt DateTime?
  searchChunks    EmailChunk[]

  // Commitments: true on the user's own sent mail until the commitment
  // scan has read it for promises ("I'll send the deck by Friday"). Set by
  // compose and sync for recent outbound mail only, so history is never
  // scanned.
  commitmentScanPending Boolean @default(false)

  // Set only when this (draft) message was created by a rule with a
  // REQUIRE_APPROVAL_CHAIN action — see ApprovalChain's schema comment.
  approvalChain ApprovalChain?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([threadId, providerMessageId])
  @@index([threadId])
  @@index([inReplyToMessageId])
  // Incremental sync gets changes as bare provider ids (Gmail history,
  // Graph delta) and must find the local row without knowing its thread.
  @@index([providerMessageId])
  @@index([priority])
  @@index([searchIndexedAt, receivedAt])
  @@index([commitmentScanPending, receivedAt])
}

/**
 * "Ask your inbox" (docs/ai-features-implementation-plan.md, Phase 1): an
 * email's text in embedded pieces, searched by meaning (pgvector) and by
 * keyword (Postgres full-text). Built by EmailIndexService from the
 * message's own text with quoted history stripped, each chunk prefixed
 * with the subject/sender/date so it stands on its own.
 *
 * accountId is copied from the thread so a search can be scoped to the
 * accounts a user belongs to without joining through the thread. Every
 * query on this table MUST be scoped that way.
 */
model EmailChunk {
  id String @id @default(uuid())

  messageId String
  message   EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  accountId String

  chunkIndex Int
  content    String

  /// Same model and width as DocumentChunk.embedding (Google
  /// gemini-embedding-001, 768 dims). No typed accessor in Prisma Client —
  /// reads and writes go through $queryRaw/$executeRaw.
  embedding      Unsupported("vector(768)")?
  embeddingModel String?

  createdAt DateTime @default(now())

  // The HNSW index on `embedding` and the GIN full-text index on
  // `content` are hand-written SQL in migration
  // 20261027090000_ask_inbox_email_chunks, invisible to Prisma. Like
  // DocumentChunk's, `prisma migrate diff`/`migrate dev` will propose
  // dropping them — never apply those lines.

  @@unique([messageId, chunkIndex])
  @@index([accountId])
}

enum AutomationEffectKind {
  RULE_ACTIONS
  TASK_EXTRACTION
  SEND
  DRAFT
}

enum AutomationEffectStatus {
  PENDING
  DONE
  // SEND only: approved for auto-send and waiting as a draft until
  // EmailMessage.scheduledSendAt (undo window, quiet hours, DELAY_SEND).
  SCHEDULED
  // SEND only: a scheduled send that was cancelled (by the user, or because
  // auto-send was switched off before it fired). Not counted by the caps.
  CANCELLED
}

/**
 * Effect ledger for the autonomous AI pipeline (see
 * docs/email-automation-implementation-plan.md §1.3). AI jobs retry on
 * failure, and every side effect (sending a reply, running a rule's
 * Slack/HubSpot/notify actions, extracting tasks) must happen at most once
 * per inbound message no matter how many times the job runs. A row is
 * written BEFORE the effect runs (claim) — the unique (messageId, kind)
 * makes a second claim fail, which is what turns a retry into a skip.
 * SEND rows double as the auto-reply history the loop-protection caps
 * count (per thread / per recipient, last 24h), so they carry threadId,
 * accountId and the recipient address.
 */
model AutomationEffect {
  id String @id @default(uuid())

  messageId String
  message   EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  accountId String
  threadId  String

  kind   AutomationEffectKind
  status AutomationEffectStatus @default(PENDING)

  // SEND only: lowercased address the reply went to, and the provider's
  // id for the sent message once the send succeeded.
  recipient         String?
  providerMessageId String?

  // SEND only: why it was allowed to go out unreviewed, for the automation
  // audit log — { ruleIds, ruleNames, confidence, documents, draftMessageId,
  // scheduledFor }. Null for rows written before this existed.
  details Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([messageId, kind])
  @@index([accountId, kind, createdAt])
  @@index([threadId, kind, createdAt])
}

enum TaskType {
  ACTION_ITEM
  MEETING_REQUEST
  // A sent message nobody answered by the thread's followUpAt.
  FOLLOW_UP
  // Something the user promised in a sent message; dueDate when it named
  // a deadline.
  COMMITMENT
}

/**
 * Attachment metadata (docs/email-automation-implementation-plan.md §6.1).
 * Only metadata is synced; the bytes are fetched from the provider on
 * download (GET /email/attachments/:id). providerAttachmentId is the
 * provider's own id (Gmail attachmentId, Graph attachment id) or, for IMAP,
 * the attachment's position in the parsed message.
 */
model EmailAttachment {
  id String @id @default(uuid())

  messageId String
  message   EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  filename             String
  mimeType             String
  size                 Int
  providerAttachmentId String
  contentId            String?
  // Inline images (signatures, logos) — not shown as attachments and not
  // counted by the hasAttachment rule condition.
  isInline             Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([messageId])
}

enum AiDraftOutcomeKind {
  // A human sent the AI draft (edited or not).
  SENT
  // A human deleted it instead.
  DISCARDED
  // It went out without review (auto-send, scheduled send).
  AUTO_SENT
}

/**
 * How the account's owner writes (greeting, sign-off, length, formality,
 * common phrases), learned from their own sent mail by the AI service's
 * style_profile capability and passed to the reply and rewrite prompts.
 * One per account; rebuilt weekly unless the user edited it, deleted when
 * the account is disconnected.
 */
model WritingStyleProfile {
  id String @id @default(uuid())

  accountId String       @unique
  account   EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // { greeting, signOff, formality, length, medianWords, language,
  //   commonPhrases, notes } — see WritingStyle in ai-client.service.ts.
  profile Json

  // How many sent messages it was learned from.
  sampleCount Int

  // Off: replies and rewrites don't use it (it's kept, not deleted).
  enabled Boolean @default(true)

  builtAt DateTime
  // Set when the user changed the profile by hand; the weekly rebuild then
  // leaves it alone. A manual rebuild clears it.
  editedAt DateTime?

  // When the account first got a profile — the before/after line for
  // measuring how much AI drafts get edited.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * One row per AI reply that reached an outcome — what the quality metrics
 * (GET /analytics/automation) are computed from. Kept separately because
 * the draft row itself is deleted when it's sent or discarded.
 */
model AiDraftOutcome {
  id String @id @default(uuid())

  accountId String
  // The agent persona that wrote it, when a rule used one. Not a relation:
  // the history outlives a deleted agent.
  agentId   String?

  outcome      AiDraftOutcomeKind
  // SENT only: whether the text was changed, how much (normalized
  // Levenshtein distance, 0 = untouched, 1 = rewritten) and how long the
  // draft waited.
  edited       Boolean?
  editDistance Float?
  timeToSendMs Int?

  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([agentId, createdAt])
}

enum TaskStatus {
  PENDING
  DONE
  DISMISSED
}

// Extracted from the /email/extract AI capability (tasks + meeting_requests)
// — apps/ai already computes this per message; this model is what persists
// it instead of discarding it, same story as EmailMessage's classification
// fields above. See docs/v1.2-plan.md's "AI Task Extraction" section.
model Task {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Both nullable and SetNull on delete: a Task should outlive the message
  // it was extracted from (e.g. still shows in the user's action items
  // after the source email is deleted), not cascade-delete with it.
  emailMessageId String?
  emailMessage   EmailMessage? @relation(fields: [emailMessageId], references: [id], onDelete: SetNull)

  threadId String?
  thread   EmailThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)

  type TaskType

  description String

  dueDate DateTime?

  status      TaskStatus @default(PENDING)
  completedAt DateTime?

  // Set only for MEETING_REQUEST tasks once scheduleMeeting() actually
  // creates the event — see CalendarService.createEvent(). Null means
  // "not yet scheduled" (or not a meeting request at all); scheduling
  // never happens automatically, only after explicit user approval.
  calendarEventId  String?
  calendarEventUrl String?

  // COMMITMENT only: when the "it's due" reminder went out, so it goes
  // out once.
  remindedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([type, status, dueDate])
  @@index([emailMessageId])
  @@index([threadId])
}

model ContactMemory {
  id String @id @default(uuid())

  // Every read/write of this table MUST be scoped by userId — this is the
  // sole isolation boundary for cross-user contact data.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  senderEmail String
  senderName  String?

  /// Structured facts synthesized by the AI: { role, company, summary, commitments }
  facts Json

  /// Embedding of the facts text, generated by the contact_memory AI
  /// capability (Google gemini-embedding-001, 768 dims). Prisma Client has
  /// no typed accessor for this column — all reads/writes go through
  /// $queryRaw/$executeRaw using pgvector's <=> operator.
  embedding Unsupported("vector(768)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, senderEmail])
  @@index([userId])
}

model Document {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  filename    String
  contentType String

  /// SHA-256 of the uploaded file's raw bytes. Checked BEFORE calling the
  /// AI service, so re-uploading a byte-identical file is free (no
  /// embedding cost). Nullable so pre-existing rows (uploaded before this
  /// column existed) don't collide — Postgres unique indexes treat NULL as
  /// distinct, so they're excluded from the uniqueness check.
  contentHash String?

  /// SHA-256 of the ordered, concatenated chunk text produced by the AI
  /// service. Informational only (not unique, not checked) — upload and
  /// processing are decoupled, so by the time this is known the AI call
  /// has already happened and there's nothing left to skip. Kept for
  /// finding likely-duplicate content across differently-named files later.
  chunkContentHash String?

  // Echoed back from the AI service's document_processing capability for
  // the run that produced this document's chunks. Null until that run
  // completes — upload and processing are now decoupled (upload enqueues a
  // job; a worker calls the AI service later), so neither is known yet at
  // Document-creation time.
  provider String?
  model    String?

  // --- Identification & organization (title defaults to filename; the
  // rest are nullable/empty until a real AI-enrichment step populates
  // them — see DocumentChunk.keywords/entities for the same pattern). ---
  title       String
  description String?
  summary     String?
  category    String?
  tags        String[] @default([])
  author      String?
  /// Team/owner distinct from author — no ownership model exists yet
  /// (single-tenant uploads), so always null until one does.
  owner       String?
  /// BCP-47 / ISO 639-1 code from langdetect (see process_document in
  /// apps/ai). Null when undetectable or the document had no
  /// extractable text.
  language    String?

  /// Origin channel. Always "upload" today (the only ingestion path); kept
  /// as a plain string, not an enum, so future sources (url, notion, s3...)
  /// don't require a migration.
  sourceType String  @default("upload")
  /// Null for uploads (there's no repo/site/app name to record) — set by
  /// future non-upload connectors.
  sourceName String?
  sourcePath String?
  sourceUrl  String?
  /// ID in an external system (e.g. a Notion page ID) — null for uploads.
  externalId String?

  /// File extension, lowercased (pdf, docx, md, txt) — what the AI service
  /// dispatches its extraction strategy on. `contentType` above already
  /// carries the MIME type, so there's no separate mimeType column.
  documentType  String
  fileExtension String
  fileSize      Int

  /// Bumped by a future re-processing/re-indexing flow; uploads always
  /// create version 1 today (each distinct upload is its own Document row).
  version Int @default(1)

  status DocumentStatus @default(PROCESSING)

  /// Extraction strategy the AI service used — pdf, docx, markdown, plain_text.
  parser       String?
  /// Splitting strategy — recursive, markdown_recursive.
  splitter     String?
  chunkSize    Int?
  chunkOverlap Int?

  /// Mirrors DocumentChunk.embedding's vector width — lets future
  /// multi-model support identify documents needing re-embedding without
  /// inspecting the vector column itself.
  embeddingDimension Int @default(768)

  /// PDF page count. Null for non-paginated formats (md/txt/docx).
  pageCount Int?

  // Aggregated from this document's chunks once indexing finishes.
  totalChunks     Int @default(0)
  totalTokens     Int @default(0)
  totalCharacters Int @default(0)

  /// Connector-specific extras that don't warrant their own column.
  metadata Json @default("{}")

  chunks DocumentChunk[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  /// Set when the chunk-insert loop completes; stays null if a crash left
  /// the row stuck at status PROCESSING with partial chunks.
  indexedAt      DateTime?
  /// Touched on read (get-by-id, search hits) — lets "most relevant /
  /// recently used" retrieval ranking be added later without a new column.
  lastAccessedAt DateTime?

  @@unique([userId, contentHash])
  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([indexedAt])
  @@index([sourceType])
  @@index([language])
  @@index([version])
  @@index([documentType])
  @@index([tags], type: Gin)
}

model DocumentChunk {
  id String @id @default(uuid())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  chunkIndex Int
  content    String

  /// Self-relation for hierarchical chunking (e.g. a table-of-contents
  /// summary chunk over several detail chunks). Not produced by the AI
  /// service yet — the flat splitter has no parent/child concept — so
  /// always null today.
  parentChunkId String?
  parentChunk   DocumentChunk?  @relation("ChunkHierarchy", fields: [parentChunkId], references: [id], onDelete: SetNull)
  childChunks   DocumentChunk[] @relation("ChunkHierarchy")

  /// SHA-256 of `content`, for chunk-level dedup/change-detection —
  /// Document.contentHash's counterpart at chunk granularity.
  contentHash String?

  /// Structure-derived context from the ai service's chunking strategy for
  /// this document type — e.g. { source, heading, section } for Markdown,
  /// { source, page } for PDF. Always has "source"; other keys are
  /// type-dependent and may be absent. section/page below mirror the two
  /// keys worth indexing directly; the rest stays here.
  metadata Json @default("{}")

  /// Heading text the chunk falls under (Markdown/DOCX). Null for chunk
  /// types with no heading structure (plain text).
  section String?
  /// 1-based page number (PDF only).
  page    Int?

  /// Character offsets of this chunk within its structural unit (the PDF
  /// page text, the Markdown/DOCX section text, or the whole document for
  /// plain text) — not within the document as a whole. Combined with
  /// page/section, still enough to locate and cite the source text.
  startChar Int?
  endChar   Int?
  /// 1-based line numbers, same "relative to its structural unit" scope
  /// as startChar/endChar above.
  lineStart Int?
  lineEnd   Int?

  /// text today (the only strategy the AI service implements); table/
  /// code/image_caption are anticipated but not yet produced.
  chunkType String @default("text")

  tokenCount     Int?
  wordCount      Int?
  characterCount Int?

  /// AI-enrichment fields — empty/null until a real enrichment step exists.
  keywords   Json @default("[]")
  entities   Json @default("[]")
  importance Int?

  /// Embedding of chunk content, generated by the ai service's
  /// document_processing capability (Google gemini-embedding-001, 768
  /// dims). Prisma Client has no typed accessor for this column — all
  /// reads/writes go through $queryRaw/$executeRaw using pgvector's <=>
  /// operator.
  embedding Unsupported("vector(768)")?

  /// Echoed per-chunk (not just on the parent Document) so a future
  /// partial re-embed — upgrading only some chunks to a newer model —
  /// stays identifiable without a join.
  embeddingModel     String?
  embeddingDimension Int     @default(768)
  embeddingVersion   Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // The HNSW vector index on `embedding` is hand-managed raw SQL, not
  // declared here — Prisma 7.9.1 rejects `type: Hnsw`, and `embedding` is an
  // Unsupported() column Prisma can't model anyway. It lives in migration
  // 20260806140000_document_retrieval_indexes. IMPORTANT: because it's
  // invisible to Prisma, every future `prisma migrate diff`/`migrate dev`
  // against this schema will propose `DROP INDEX
  // "DocumentChunk_embedding_hnsw_idx"` — never apply that line.

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@index([page])
  @@index([section])
  @@index([chunkType])
  @@index([tokenCount])
  @@index([parentChunkId])
}
