generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

enum EmailProvider {
  GOOGLE
  MICROSOFT
  IMAP
}

enum MailFolderType {
  INBOX
  SENT
  DRAFTS
  TRASH
  SPAM
  ARCHIVE
  CUSTOM
}

enum SyncStatus {
  IDLE
  SYNCING
  ERROR
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
}

model User {
  id          String  @id @default(uuid())
  email       String  @unique
  displayName String?
  avatar      String?

  // Null for OAuth-only users (Google/Microsoft) who never set a password.
  passwordHash    String?
  emailVerifiedAt DateTime?

  googleId    String? @unique
  microsoftId String? @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  emailAccounts      EmailAccount[]
  refreshTokens      RefreshToken[]
  notifications      Notification[]
  verificationTokens VerificationToken[]
  contactMemories    ContactMemory[]

  @@index([createdAt])
}

model VerificationToken {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type VerificationTokenType

  tokenHash String @unique

  /** Only set for EMAIL_CHANGE: the address being switched to. */
  newEmail String?

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId, type])
}

model Notification {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String
  body     String
  metadata Json?

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model RefreshToken {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  // Captured at issuance for the "active sessions" list.
  userAgent   String?
  ipAddress   String?
  deviceLabel String?

  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailAccount {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider EmailProvider

  email       String
  displayName String?

  isPrimary   Boolean @default(false)
  syncEnabled Boolean @default(true)

  // Classification categories (from the AI classify capability) that are
  // safe to auto-send a drafted reply for on this account. Empty by
  // default: nothing auto-sends until explicitly configured.
  autoSendCategories String[] @default([])

  // IMAP-only connection settings (host/port/secure/username); null for GOOGLE/MICROSOFT
  imapConfig Json?

  syncStatus   SyncStatus @default(IDLE)
  lastSyncedAt DateTime?
  lastSyncError String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  credential EmailCredential?

  folders MailFolder[]
  threads EmailThread[]

  @@unique([provider, email])
  @@index([userId])
}

model EmailCredential {
  id String @id @default(uuid())

  accountId String       @unique
  account   EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MailFolder {
  id String @id @default(uuid())

  accountId String
  account   EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  providerFolderId String?

  name String

  type MailFolderType

  /** Opaque provider cursor (Gmail historyId, Graph delta token, IMAP UID) for incremental sync. */
  syncCursor String?

  threads EmailThread[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, providerFolderId])
  @@index([accountId])
}

model EmailThread {
  id String @id @default(uuid())

  // The account this conversation belongs to. Provider thread IDs are
  // stable across folders/labels (e.g. Gmail keeps the same thread ID
  // for a message whether it's under INBOX or SENT), so thread identity
  // is scoped per-account, not per-folder.
  accountId String
  account   EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // The folder this thread is primarily displayed under. Set once when
  // the thread is first created and left unchanged afterwards, so a
  // reply doesn't move an Inbox conversation into "Sent".
  folderId String
  folder   MailFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  providerThreadId String

  subject String?

  snippet String?

  lastMessageAt DateTime?

  messages EmailMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, providerThreadId])
  @@index([folderId])
}

model EmailMessage {
  id String @id @default(uuid())

  threadId String
  thread   EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  providerMessageId String

  from Json

  to Json

  cc Json?

  bcc Json?

  subject String?

  bodyText String?

  bodyHtml String?

  receivedAt DateTime

  isRead Boolean @default(false)

  // Set when this message is an AI-drafted reply awaiting review (a local
  // draft, not yet sent) — points at the message it's replying to.
  inReplyToMessageId String?
  inReplyTo           EmailMessage?  @relation("MessageReplies", fields: [inReplyToMessageId], references: [id], onDelete: SetNull)
  draftReplies        EmailMessage[] @relation("MessageReplies")

  // Set once the autonomous AI pipeline (classify -> contact memory ->
  // reply) has run for this message, so retries/resyncs don't reprocess it.
  aiProcessedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([threadId, providerMessageId])
  @@index([threadId])
  @@index([inReplyToMessageId])
}

model ContactMemory {
  id String @id @default(uuid())

  // Every read/write of this table MUST be scoped by userId — this is the
  // sole isolation boundary for cross-user contact data.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  senderEmail String
  senderName  String?

  /// Structured facts synthesized by the AI: { role, company, summary, commitments }
  facts Json

  /// Embedding of the facts text, generated by the contact_memory AI
  /// capability (Google gemini-embedding-001, 768 dims). Prisma Client has
  /// no typed accessor for this column — all reads/writes go through
  /// $queryRaw/$executeRaw using pgvector's <=> operator.
  embedding Unsupported("vector(768)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, senderEmail])
  @@index([userId])
}
