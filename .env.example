# Root .env — consumed by docker-compose.prod.yml for variable
# interpolation (${DOMAIN} etc.), NOT loaded by any app service directly.
# Per-service runtime config lives in apps/api/.env and apps/ai/.env — see
# their own .env.example files and docs/deployment.md.
#
# Only used for production (docker-compose.prod.yml). Local dev
# (docker-compose.yml) doesn't read this file at all.

# Postgres password for the production database — generate with:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# DNS: both must already resolve to this server's IP before first start —
# Caddy's automatic TLS (Let's Encrypt) needs that to issue certificates.
DOMAIN=app.example.com
API_DOMAIN=api.example.com

# Baked into web's client bundle at BUILD time (Next.js NEXT_PUBLIC_* vars
# are inlined, not read at runtime) — must match API_DOMAIN above.
NEXT_PUBLIC_API_URL=https://api.example.com

# Let's Encrypt registration contact (expiry/issue notifications only).
ACME_EMAIL=you@example.com
